{
    "name": "@hodfords/nestjs-oidc",
    "version": "11.0.11",
    "description": "NestJS OIDC Provider",
    "license": "MIT",
    "readmeFilename": "README.md",
    "author": {
        "name": "Minh Ngo",
        "email": "minh.ngo@hodfords.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hodfords-solutions/nestjs-oidc"
    },
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-oidc/issues"
    },
    "tags": [
        "typescript",
        "nestjs",
        "oidc"
    ],
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "^11.0.2",
        "@hodfords/nestjs-prettier-config": "^11.0.1",
        "@nestjs/common": "11.1.12",
        "@nestjs/core": "11.1.12",
        "@nestjs/swagger": "^11.2.5",
        "@types/bcrypt": "^6.0.0",
        "@types/jest": "30.0.0",
        "@types/lodash.isempty": "^4.4.9",
        "@types/node": "25.2.0",
        "@types/oidc-provider": "9.5.0",
        "cspell": "9.6.3",
        "eslint": "9.39.2",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "jest": "30.2.0",
        "lint-staged": "16.2.7",
        "lodash": "4.17.23",
        "openid-client": "6.8.1",
        "prettier": "3.8.1",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.2",
        "ts-jest": "29.4.6",
        "ts-node": "10.9.2",
        "typescript": "5.9.3"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "start:dev": "npm run prebuild && nest start --watch",
        "start": "ts-node sample/index.ts",
        "build": "tsc --project tsconfig.prod.json && cp package.json dist && cp README.md dist && cp .npmrc dist",
        "deploy": "npm run build && npm publish dist",
        "format": "prettier --write \"**/*.ts\"",
        "check": "prettier --check \"**/*.ts\"",
        "test": "jest --passWithNoTests  --testTimeout=450000 ",
        "cspell": "cspell",
        "prepare": "is-ci || husky",
        "lint": "eslint \"lib/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "dependencies": {
        "@nestjs/platform-express": "11.1.12",
        "ioredis": "^5.9.2",
        "lodash.isempty": "^4.4.0",
        "oidc-provider": "9.6.0"
    },
    "overrides": {
        "lodash": "4.17.23"
    }
}
