{
    "name": "@hodfords/nestjs-oidc",
    "version": "12.0.0",
    "description": "NestJS OIDC Provider",
    "license": "MIT",
    "readmeFilename": "README.md",
    "author": {
        "name": "Minh Ngo",
        "email": "minh.ngo@hodfords.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hodfords-solutions/nestjs-oidc"
    },
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-oidc/issues"
    },
    "tags": [
        "typescript",
        "nestjs",
        "oidc"
    ],
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "^11.0.2",
        "@hodfords/nestjs-prettier-config": "^11.0.1",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/swagger": "12.0.0",
        "@swc/core": "^1.13.5",
        "@types/bcrypt": "^6.0.0",
        "@types/lodash.isempty": "^4.4.9",
        "@types/node": "25.2.0",
        "@types/oidc-provider": "9.5.0",
        "cspell": "9.6.3",
        "eslint": "9.39.2",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "16.2.7",
        "lodash": "4.17.23",
        "openid-client": "6.8.1",
        "prettier": "3.8.1",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.2",
        "tsx": "^4.20.6",
        "typescript": "5.9.3",
        "unplugin-swc": "^1.5.7",
        "vitest": "^4.1.10"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "start:dev": "npm run prebuild && nest start --watch",
        "start": "tsx sample/main.ts",
        "build": "tsc --project tsconfig.prod.json && cp package.json dist && cp README.md dist && cp .npmrc dist",
        "deploy": "npm run build && npm publish dist",
        "format": "prettier --write \"**/*.ts\"",
        "check": "prettier --check \"**/*.ts\"",
        "test": "vitest run",
        "cspell": "cspell",
        "prepare": "is-ci || husky",
        "lint": "eslint \"lib/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage"
    },
    "dependencies": {
        "@nestjs/platform-express": "12.0.1",
        "ioredis": "^5.9.2",
        "lodash.isempty": "^4.4.0",
        "oidc-provider": "9.6.0"
    },
    "overrides": {
        "lodash": "4.17.23"
    },
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
