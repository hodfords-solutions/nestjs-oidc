{
    "name": "@hodfords/nestjs-oidc",
    "version": "12.3.1",
    "packageManager": "pnpm@12.0.0",
    "description": "NestJS OIDC Provider",
    "license": "MIT",
    "readmeFilename": "README.md",
    "author": {
        "name": "Minh Ngo",
        "email": "minh.ngo@hodfords.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hodfords-solutions/nestjs-oidc"
    },
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-oidc/issues"
    },
    "tags": [
        "typescript",
        "nestjs",
        "oidc"
    ],
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "^11.0.4",
        "@hodfords/nestjs-prettier-config": "^11.0.2",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/swagger": "12.0.1",
        "@swc/core": "^1.16.1",
        "@types/bcrypt": "^6.0.0",
        "@types/node": "26.4.0",
        "@types/oidc-provider": "9.11.1",
        "cspell": "10.1.1",
        "eslint": "10.9.1",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "17.4.1",
        "openid-client": "6.8.7",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "tsx": "^4.23.12",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "express": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "express": {
            "optional": true
        }
    },
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "start:dev": "pnpm run prebuild && nest start --watch -p tsconfig.sample.json",
        "start": "tsx sample/main.ts",
        "build": "tsc --project tsconfig.prod.json && cp package.json dist && cp README.md dist && cp .npmrc dist",
        "deploy": "pnpm run build && pnpm publish dist",
        "format": "prettier --write \"**/*.ts\"",
        "check": "prettier --check \"**/*.ts\"",
        "test": "vitest run",
        "cspell": "cspell",
        "prepare": "is-ci || husky",
        "lint": "eslint \"lib/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage"
    },
    "dependencies": {
        "es-toolkit": "1.52.0",
        "ioredis": "^6.0.0",
        "oidc-provider": "9.12.0"
    },
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
