{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2023",
        "types": ["node"],
        "lib": ["es2023"],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "rootDir": "./lib",
        "outDir": "dist",
        "incremental": true,
        "strictNullChecks": false,
        "noImplicitAny": false,
        "strictBindCallApply": false
    },
    "include": ["lib"],
    "exclude": ["tests", "test", "sample", "dist", "node_modules"]
}
